+const CUSTOM_STATUS_CODES = 'custom-status-codes';
+
+const statusCodeComparisons: Record<string, (statusCode: number, value: number) => boolean> = {
+  '': (statusCode, value) => statusCode === value,
+  '!=': (statusCode, value) => statusCode !== value,
+  '<': (statusCode, value) => statusCode < value,
+  '<=': (statusCode, value) => statusCode <= value,
+  '>': (statusCode, value) => statusCode > value,
+  '>=': (statusCode, value) => statusCode >= value,
+};
+
+/**
+ * Parses a comma-separated list of status codes (`404`), ranges (`200-204`, `200..204`)
+ * and comparisons (`>=500`, `!=304`). A status code matches if it matches any term.
+ * Status code 0 (failed, blocked or unfinished requests) never matches.
+ * Returns null for an empty or invalid expression.
+ */
+export function parseStatusCodeExpression(expression: string): ((statusCode: number) => boolean)|null {
+  const matchers: Array<(statusCode: number) => boolean> = [];
+  for (const term of expression.split(',')) {
+    const range = /^\s*(\d{1,3})\s*(?:-|\.\.)\s*(\d{1,3})\s*$/.exec(term);
+    if (range) {
+      const from = Number(range[1]);
+      const to = Number(range[2]);
+      if (from > to) {
+        return null;
+      }
+      matchers.push(statusCode => statusCode >= from && statusCode <= to);
+      continue;
+    }
+    const comparison = /^\s*(!=|<=|>=|<|>)?\s*(\d{1,3})\s*$/.exec(term);
+    if (!comparison) {
+      return null;
+    }
+    const compare = statusCodeComparisons[comparison[1] ?? ''];
+    const value = Number(comparison[2]);
+    matchers.push(statusCode => compare(statusCode, value));
+  }
+  return statusCode => statusCode !== 0 && matchers.some(matcher => matcher(statusCode));
+}
