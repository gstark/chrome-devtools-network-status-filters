+  private showStatusCodeExpressionDialog(anchor: HTMLElement): void {
+    const dialog = new UI.Dialog.Dialog('status-code-expression');
+    dialog.setAriaLabel(i18nString(UIStrings.statusCodeExpression));
+    dialog.setSizeBehavior(UI.GlassPane.SizeBehavior.MEASURE_CONTENT);
+    dialog.setAnchorBehavior(UI.GlassPane.AnchorBehavior.PREFER_BOTTOM);
+    dialog.setContentAnchorBox(anchor.boxInWindow());
+
+    const input = UI.UIUtils.createInput('', 'text', 'status-code-expression');
+    input.value = this.networkStatusCodeExpressionSetting.get();
+    input.placeholder = i18n.i18n.lockedString('404, 200-204, >=500');
+    UI.ARIAUtils.setLabel(input, i18nString(UIStrings.statusCodeExpression));
+    const setInvalid = (invalid: boolean): void => {
+      input.classList.toggle('error-input', invalid);
+      UI.ARIAUtils.setInvalid(input, invalid);
+    };
+    input.addEventListener('input', () => setInvalid(false));
+    input.addEventListener('keydown', event => {
+      if (event.key !== 'Enter') {
+        return;
+      }
+      event.consume(true);
+      const expression = input.value.trim();
+      if (expression && !parseStatusCodeExpression(expression)) {
+        setInvalid(true);
+        return;
+      }
+      this.setStatusCodeExpression(expression);
+      dialog.hide();
+    });
+    dialog.contentElement.appendChild(input);
+    dialog.setDefaultFocusedElement(input);
+
+    dialog.addEventListener(UI.Dialog.Events.HIDDEN, () => {
+      // Without an expression the custom bit does not filter, so deselect it.
+      if (!this.networkStatusCodeExpressionSetting.get()) {
+        const filters = {...this.networkStatusClassFiltersSetting.get()};
+        delete filters[CUSTOM_STATUS_CODES];
+        this.networkStatusClassFiltersSetting.set(filters);
+      }
+    });
+    dialog.show(this.element);
   }
 
