+      assert.deepEqual(shownRequestUrls(), ['url0', 'url200', 'url301', 'url404', 'url500']);
+    });
+
+    it('shows only 4xx requests when "4xx" is active', () => {
+      const {shownRequestUrls, clickStatusButton} = setUpStatusCodeFilter();
+
+      clickStatusButton('4xx');
