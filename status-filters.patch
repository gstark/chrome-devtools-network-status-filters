+  describe('parseStatusCodeExpression', () => {
+    const statusCodes = [0, 199, 200, 204, 205, 301, 304, 399, 400, 404, 500, 503];
+    function matchingStatusCodes(expression: string): number[] {
+      const matcher = Network.NetworkLogView.parseStatusCodeExpression(expression);
+      assert.exists(matcher);
+      return statusCodes.filter(statusCode => matcher(statusCode));
+    }
+
+    it('matches a single status code', () => {
+      assert.deepEqual(matchingStatusCodes('404'), [404]);
+    });
+
+    it('matches inclusive ranges with "-" and ".."', () => {
+      assert.deepEqual(matchingStatusCodes('200-204'), [200, 204]);
+      assert.deepEqual(matchingStatusCodes('200..204'), [200, 204]);
+      assert.deepEqual(matchingStatusCodes(' 200 - 204 '), [200, 204]);
+    });
+
+    it('matches comparisons', () => {
+      assert.deepEqual(matchingStatusCodes('>=500'), [500, 503]);
+      assert.deepEqual(matchingStatusCodes('>399'), [400, 404, 500, 503]);
+      assert.deepEqual(matchingStatusCodes('<=204'), [199, 200, 204]);
+      assert.deepEqual(matchingStatusCodes('< 200'), [199]);
+      assert.deepEqual(matchingStatusCodes('!=304'), [199, 200, 204, 205, 301, 399, 400, 404, 500, 503]);
+    });
+
+    it('matches any term of a comma-separated list', () => {
+      assert.deepEqual(matchingStatusCodes('404, 200-204, >=503'), [200, 204, 404, 503]);
+    });
+
+    it('never matches status code 0', () => {
+      assert.notInclude(matchingStatusCodes('<300'), 0);
+      assert.notInclude(matchingStatusCodes('0-999'), 0);
+    });
+
+    it('rejects empty and invalid expressions', () => {
+      for (const expression of ['', ' ', 'abc', '4xx', '204-200', '1000', '200,', '>=', '200-', '=>200']) {
+        assert.isNull(Network.NetworkLogView.parseStatusCodeExpression(expression), expression);
+      }
+    });
+  });
