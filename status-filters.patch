+          n => (n as Network.NetworkDataGridNode.NetworkNode).request()?.url() as string | undefined);
+
+      const clickStatusButton = (label: string, multiSelect = false) => {
+        const group = filterBar.element.querySelector('[aria-label="Status codes to include"]');
+        const button = [...group?.querySelectorAll('span') ?? []].find(span => span.textContent === label);
+        assert.exists(button);
+        button.dispatchEvent(
+            new MouseEvent('click', {bubbles: true, [Host.Platform.isMac() ? 'metaKey' : 'ctrlKey']: multiSelect}));
